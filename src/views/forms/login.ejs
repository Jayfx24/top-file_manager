<!DOCTYPE html>
<html lang="en">
<%- include("../partials/head.ejs") %>

<body>
  <!-- <%- include("../partials/header.ejs") %> -->

  <main>
    <div class="">

      <div class="layout--auth">
        <div class="image-container"></div>

        <div class="form-container">
          <div class="form-info">
            <h1 class="form__title">
              Welcome back!
            </h1>
            <p class="form__description">Log in to access your personal files and folders.</p>
          </div>
          <%- include("../partials/errors.ejs") %>
          <form action="" method="post">
            <div class="form-group">
              <label for="username">
                Username
              </label>
              <input type="input" class="f-input" id="username" name="username" placeholder="Enter your username">
            </div>
            <div class="form-group">
              <label for="pwd">
                Password
              </label>
              <input type="password" class="f-input" id="pwd" name="pwd" placeholder="Enter your password">
            </div>
            <div class="form-actions"><button type="submit" class="form-btn btn--login">Login</button></div>
          </form>

          <div class="form-footer">
            <p> Don't have an acount? <span><a href="/register">Sign up</a></span></p>
          </div>
        </div>
      </div>

    </div>

  </main>

  <%- include("../partials/footer.ejs") %>
</body>

</html>