<!DOCTYPE html>
<html lang="en">
<%- include("../partials/head.ejs") %>

    <body>
        <%- include("../partials/header.ejs") %>

            <main>
                <section class="content">
                    <div class="form-container">

                        <%- include("../partials/errors.ejs") %>


                            <form action="" method="post">
                                <div class="form-group">
                                    <label for="firstName">
                                        First name
                                    </label>
                                    <input type="input" class="f-input" id="firstName" name="firstName">
                                </div>
                                <div class="form-group">
                                    <label for="lastName">
                                        Last name
                                    </label>
                                    <input type="input" class="f-input" id="lastName" name="lastName">
                                </div>
                                <div class="form-group">
                                    <label for="username">
                                        Username
                                    </label>
                                    <input type="input" class="f-input" id="username" name="username">
                                </div>
                                <div class="form-group">
                                    <label for="pwd">
                                        Password
                                    </label>
                                    <input type="password" class="f-input" id="pwd" name="pwd">
                                </div>
                                <div class="form-group">
                                    <label for="cPwd">
                                        Confirm Password
                                    </label>
                                    <input type="password" class="f-input" id="cPwd" name="cPwd">
                                </div>
                                <button type="submit" class="form-btn">Register</button>

                            </form>
                    </div>

                </section>

            </main>

            <%- include("../partials/footer.ejs") %>
    </body>

</html>