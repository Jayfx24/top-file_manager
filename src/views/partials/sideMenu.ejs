<aside class="sideMenu border">
    <div class="aside-content ">
        <div class="actions">
            <div class=""><button command="show-modal" commandfor="folder-dialog">New Folder</button></div>
            <button command="show-modal" commandfor="file-dialog">New file</button>
            <div class="action__errors">
                <%- include("../partials/errors.ejs") %>

            </div>
        </div>
        <h2>
            Projects
        </h2>
        <ul class="folder__list">
            <% locals?.folders.forEach((value)=> { %>
                <li class="folder__item">
                    <%= value.name %>
                </li>
                <% })%>
        </ul>




        <h2>
            Shared
        </h2>
    </div>

</aside>


<%- include("../dialogs/folder.ejs") %>
    <%- include("../dialogs/file.ejs") %>