<!DOCTYPE html>
<html lang="en">
<%- include("./partials/head.ejs") %>

<body>
  <%- include("./partials/header.ejs") %>
  <main>
    <section class="container">
      <div class="content">
        <div class="content--file">
          <div class="file__texts">
            <div>
              <h1 class="file__name">
                <%= file.name%>
              </h1>



              <a href="<%= file.id %>/download">Download</a>

            </div>

            <div class="file__info">
              <ul class="info__list">
                <li class="info__item">
                  <span class="info">size</span>
                  <span class="info__value"> <%= formatBytes(file.size) %></span>
                </li>
                <li class="info__item">
                  <span class="info">type</span>
                  <span class="info__value"> <%= file.mimetype %></span>
                </li>
                <li class="info__item">
                  <span class="info">Added date</span>
                  <span class="info__value"> <%= file.createdAt.toDateString() %></span>
                </li>
                <% if (file.updatedAt){%>
                <li class="info__item">
                  <span class="info">Last updated</span>

                  <span class="info__value"> <%= file.updatedAt.toDateString()%></span>
                </li>
                <%}%>
                  </ul>
          </div>
          <div class="viewer-container">
            <% if (file.mimetype.split("/")[0] === "image") {%>
                <h2 class="file__preview">Preview</h2>
                <div class="file__image">
                  <img class="view__image" src="<%=file.url%>" alt="<%=file.name%>">
                </div>

                <%}%>
            <!-- the view -->
          </div>
        </div>
      </div>
      </div>
    </section>
  </main>
</body></span>
</p>