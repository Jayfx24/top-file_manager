<dialog id="dialog--update" closedby="any">
  <div class="dialog-container">
    <div class="dialog__info">
      <h1 class="dialog__title">Update Details</h1>
      <p class="dialog-description">Make changes to your file or folder and keep everything up to date.</p>
    </div>

    <form action="/update" method="post">
      <div class="form-group">
        <label for="fileName">
          Enter new file name
        </label>
        <input type="text" name="fileName" id="fileName">
        <input type="hidden" name="fileId" id="fileId">
        <input type="hidden" name="parentId" id="parentId">
        <input type="hidden" name="fileType" id="fileType">
        <input type="hidden" name="originalName" id="originalName">
      </div>
      <button type="submit" class="form-btn">Update</button>
    </form>
     <div class="dialog__actions">
      <button type="button" commandfor="dialog--update" command="close" class="strip icon--warning">
        <i class="icons " data-lucide="x">
        </i>
      </button>
  </div>
</dialog>