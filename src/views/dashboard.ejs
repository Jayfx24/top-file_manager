<!DOCTYPE html>
<html lang="en">
<%- include("./partials/head.ejs") %>

<body>
  <%- include("./partials/header.ejs") %>

  <main>

    <section class="container">
      
      <div class="content flex gap">
        <%- include("./partials/sideMenu.ejs") %>

        <div class="main-content">
          <!-- <p>This should show the the content of the projects | all</p> -->
          <% if (locals.breadcrumbs) {%>

          <%- include("./partials/breadcrumb.ejs") %>
          <%}%>

          
          <% if (locals.folders){%>
          <table class="table border">
            <thead class="table_header">
              <tr class="th__row">
                <th class="th__item">File Name</th>
                <th class="th__item">size</th>
                <th class="th__item">created</th>
                <% if(locals.currentUser || !locals.shareUrl){%>
                <th class="th__item">last opened</th>
                <th class="th__item">actions</th>
                <%}%>
              </tr>
            </thead>


            <% locals.folders.forEach((folder)=> { %>
                <% if (folder.parentId===parentId){%>
            <tbody>
              <tr class="tr__row">
                <td class="tr__item">
                  <% if (locals.shareUrl){%>
                  <a href="/share/folder/<%=shareUrl %>/<%=folder?.id%>">
                    <%= folder.name %>
                  </a>
                  <% }else{%>
                  <a href="/folders/<%=folder?.id%>">
                    <%= folder.name %>
                  </a>
                  <% }%>
                </td>
                <td class="tr__item">
                  <%= folder?.size || '' %>
                </td>

                <td class="tr__item">
                  <%= folder.createdAt.toLocaleDateString() %>
                </td>

                <% if(locals.currentUser === folder.authorId){%>
                <td class="tr__item">
                  <%= folder.lastSeen %>
                </td>
                <td class="tr__item">
                  <div class="action__btns flex">
                    <form action="/folders/<%=folder.id%>/delete" method="post"><button class="delete">delete</button></form>
                    <button class="dialog--update" command="show-modal" commandfor="dialog--update" data-id="<%=folder.id%>" data-type="folder" data-name="<%=folder.name%>" data-parent="<%= folder.parentId %>">Update</button>
                    <button class="dialog--share" command="show-modal" commandfor="dialog--share" data-id="<%=folder.id%>" data-type="folder" data-name="<%=folder.name%>" data-func="share" data-parent="<%= folder.parentId %>">Share</button>
                  </div>
                </td>
                <%}%>
              </tr>

              <% }%>

                <% })%>
                <% if (locals.userFiles){%>
                <% locals?.userFiles.forEach((file)=> { %>
                <% if (file.folderId===parentId){%>
              <tr class="tr__row">
                <td class="tr__item">
                  <% if (locals.shareUrl){%>
                  <a href="/share/file/<%=shareUrl%>/<%=file.folderId%>/<%=file.id%>">
                    <%= file.name %>
                  </a>
                  <% }else{%>
                  <a href="/files/<%=file?.id%>">
                    <%= file.name %>
                  </a>
                  </a>
                  <% }%>

                </td>

                <td class="tr__item">
                  <%= file?.size || '0' %>
                </td>

                <td class="tr__item">
                  <%= file.createdAt.toLocaleDateString() %>


                  %>
                </td>

                <% if(locals.currentUser === file.authorId){%>
                <td class="tr__item">
                  <%= file.lastSeen %>
                </td>
                <td class="tr__item">
                  <div class="action__btns flex">
                    <form action="/files/<%=file.id%>/delete" method="post"><button class="delete">delete</button></form>

                    <button class="dialog--update" command="show-modal" commandfor="dialog--update" data-id="<%=file.id%>" data-type="file" data-name="<%=file.name%>" data-parent="<%= file.folderId %>">Update</button>
                  </div>
                </td>
                <%}%>
              </tr>

              <% }%>

                <% })%>

                <%}%>

                                                </tbody>
                                    </table>
                                    <%}%>

        </div>
      </div>

    </section>

  </main>

  <%- include("./partials/footer.ejs") %>
</body>

</html>