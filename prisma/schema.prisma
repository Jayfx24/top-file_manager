
generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}


model User {
  id Int    @id @default(autoincrement())
  firstName String
  lastName String
  username String   @unique
  pwd String
  folders Folder[]
  createdAt DateTime @default(now())

  @@map("users")
}


model Folder {
  id Int    @id @default(autoincrement())
  name String  
  createdAt DateTime @default(now())
  updatedAt DateTime? 
  author User   @relation(fields: [authorId], references: [id])
  authorId Int
  files File[]



  @@unique([name,authorId])
  @@map("folders")

}



model File {
  id Int    @id @default(autoincrement())
  name String  
  size Int
  url String  
  createdAt DateTime @default(now())
  updatedAt DateTime 
  folder Folder   @relation(fields: [folderId], references: [id])
  folderId Int


  @@unique([name,folderId])
  @@map("files")

}
