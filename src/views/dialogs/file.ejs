<dialog id="file-dialog" closedby="any">

  <div class="dialog-container">
    <div class="dialog__info">
      <h1 class="dialog__title">Upload a File</h1>
      <p class="dialog-description">Add files to your workspace and access them whenever you need.</p>

     
    </div>
    <form action="/files/<%=locals.parentId || '0'%>/upload" method="post" enctype="multipart/form-data">
      <div class="form-group">
        <label for="uploaded_file"></label>
        <input type="file" name="uploaded_file" id="uploaded_file" accept=".xlsx,.xls,image/*,.doc, .docx,.ppt, .pptx,.txt,.pdf">
        
      </div>
      <div class="notice">
        <p class="">
          Accepted file types are: <span class="">.xlsx,.xls,image/*,.doc, .docx,.ppt, .pptx,.txt,.pdf</span>
        </p>
        <span>Max upload limit - <span>9mb</span></span>
      </div>
      <button type="submit" class="form-btn">Upload</button>
    </form>
    <div class="dialog__actions">
      <button type="button" data-dialog-close="file-dialog" class=" dialog-close strip icon--warning">
        <i class="icons " data-lucide="x">
        </i>
      </button>
    </div>
  </div>

</dialog>