        <% function walk(folder, data) { if (!data) return '' ; const children=data[String(folder.id)] ?? []; if
            (children.length <=0) return "" ; let html=`<ul class="sub__list">`;

            children.forEach((ele) => {
            html += `
            <li class="folder__item">
                <a href="/folders/${ele?.id}">
                    ${ele.name}
                </a>
                ${walk(ele, data)}
            </li>`;
            });
            html += `</ul>`;
            return html;
            }


            %>
            <ul class="folder__list">
                <% locals?.anchorFolders.forEach((anchor)=> { %>
                    <li class="folder__item">
                        <a href="/folders/<%=anchor?.id%>">
                            <%= anchor.name %>
                        </a>

                        <%- walk(anchor,gp) %>

                    </li>
                    <% })%>
            </ul>







