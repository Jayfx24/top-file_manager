<!DOCTYPE html>
<html lang="en">
<%- include("./partials/head.ejs") %>

<body>
  <%- include("./partials/header.ejs") %>
  <main>
    <section class="container">
      <div class="content">
        <div class="shared__content">
          <div class="shared__texts">
            <h1 class="title">Control access to your shared folder.</h1>
            <p class="description">Manage who can view and collaborate on your folder. Update existing permissions, or remove access whenever needed</p>
          </div>
          <% if (locals.userSharedData) {%>
          <table class="shared__table">
            <thead class="t__header">
              <tr class="th__row">
                <th class="th__item">Folder </th>
                <th class="th__item">Share link</th>
                <th class="th__item">Share on</th>
                <th class="th__item">Expires in</th>
                <th class="th__item">Views</th>
                <th class="th__item">Status</th>
                
                <th class="th__item">Actions</th>
              </tr>
            </thead>
            <tbody>
              <% userSharedData.forEach((item)=>{%>
              <tr class="t-row">
                <td class="t__item">
                  <p>
                    <%= item.folders.name %>
                  </p>
                </td>

                <td class="t__item">

                  <a href="<%= fullUrl(item.itemId,item.generatedUrl) %>" class="">
                    <%= fullUrl(item.itemId,item.generatedUrl) %>
                  </a>

                </td>

                <td class="t__item">
                  <p>
                    <%= item.createdAt.toLocaleDateString() %>
                  </p>
                </td>

                <td class="t__item">
                  <p>
                    <%= differenceInDays(item.endDate, new Date()) < 1 ? '-': differenceInDays(item.endDate, new Date()) + ' days' %> 
                  </p>
                </td>


                <td class="t__item">
                  <p>
                    <%= item.viewsCount  %>
                  </p>
                </td>


                <td class="t__item">
                  <p>
                    <%= item.isActive %>
                  </p>
                </td>

                <td class="t__item">
                  <% if (item.isActive){ %>
                    <form action="/share/<%= item.generatedUrl %>/deactivate" method="post">
                      <button type="submit">Deactivate</button>
                    </form>

                  <%}%>
                </td>
              </tr>
              <%})%>




            </tbody>
          </table>
          <%}else{%>
            <!-- <h2 class="">No active share link</h2> -->
          <%}%>
        </div>
      </div>
    </section>
  </main>
</body>

</html>