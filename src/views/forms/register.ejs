<!DOCTYPE html>
<html lang="en">
<%- include("../partials/head.ejs") %>

<body>
  <!-- <%- include("../partials/header.ejs") %> -->

  <main>
    <div class="layout--auth">
        <div class="form-container">
          <div class="form-info">
            <h1 class="form__title">
              Your Files. Your Space.
            </h1>
            <p class="form__description">
                A simple, secure place for everything you need to keep.</p>
          </div>
          <%- include("../partials/errors.ejs") %>
  
  
          <form action="" method="post">
            <div class="row gap-4">
              <div class="form-group">
                <label for="firstName">
                  First name
                </label>
                <input type="input" class="f-input" id="firstName" name="firstName" placeholder="Enter your first name">
                        </div>
              <div class="form-group">
                <label for="lastName">
                  Last name
                </label>
                <input type="input" class="f-input" id="lastName" name="lastName"  placeholder="Enter your last name">
              </div>
            </div>
            <div class="form-group">
              <label for="username">
                Username
              </label>
              <input type="input" class="f-input" id="username" name="username"  placeholder="Enter your preferred username">
            </div>
            <div class="form-group">
              <label for="pwd">
                Password
              </label>
              <input type="password" class="f-input" id="pwd" name="pwd"  placeholder="Enter your password  - should contain info">
            </div>
            <div class="form-group">
              <label for="cPwd">
                Confirm Password
              </label>
              <input type="password" class="f-input" id="cPwd" name="cPwd"  placeholder="Confirm password">
            </div>
            <div class="form-actions"><button type="submit" class="form-btn">Register</button></div>
  
          </form>
          <div class="form-footer">
              <p> Have an account? <span><a href="/login">Sign in</a></span></p>
            </div>
        </div>
      <div class="image-container"></div>

    </div>

  </main>

  <%- include("../partials/footer.ejs") %>
</body>

</html>