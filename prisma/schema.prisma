generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        Int      @id @default(autoincrement())
  firstName String
  lastName  String
  username  String   @unique
  pwd       String
  folders   Folder[]
  files     File[]
  shared    Shared[]
  createdAt DateTime @default(now())

  @@map("users")
}

model Folder {
  id        Int       @id @default(autoincrement())
  name      String
  parentId  Int       @default(0)
  authorId  Int
  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt
  author    User      @relation(fields: [authorId], references: [id])
  files     File[]
  lastSeen  DateTime?
  shared    Shared[]

  @@unique([name, authorId])
  @@map("folders")
}

model File {
  id           Int       @id @default(autoincrement())
  authorId     Int
  name         String
  originalName String
  size         Int
  url          String
  encoding     String
  mimetype     String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime? @updatedAt
  folder       Folder    @relation(fields: [folderId], references: [id])
  folderId     Int
  lastSeen     DateTime?
  author       User      @relation(fields: [authorId], references: [id])

  @@unique([name, folderId])
  @@map("files")
}

model Shared {
  // id           Int       @id @default(autoincrement())
  authorId     Int
  itemId       Int
  size         Int?
  generatedUrl String    @unique
  createdAt    DateTime  @default(now())
  isActive     Boolean
  endDate      DateTime
  type         FileType
  lastSeen     DateTime?
  viewsCount   Int       @default(0)
  author       User      @relation(fields: [authorId], references: [id])
  folders      Folder    @relation(fields: [itemId], references: [id])

  @@id([generatedUrl])
  @@map("shared")
}

model Session {
  id        String   @id
  sid       String   @unique
  data      String // MediumText may be needed for MySql
  expiresAt DateTime
}

enum FileType {
  folder
  file
}
