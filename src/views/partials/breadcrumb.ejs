<div class="breadcrumbs ">
<% if (locals.breadcrumbs.length === 1){%>
  <button onclick="history.back()">Back</button>

<%}else{%>
  <% locals.breadcrumbs?.forEach((item, index) =>{ %>
  <a href="<%=item.base%>/<%=item.id%>" class="crumbs <%= locals.currentPage.base === item.base &&  currentPage.path  === item.id ?'crumbs--active': ''%>">
    <%=item.label%>
  </a>
  <% if (index < breadcrumbs.length - 1){ %>
  <span class="icon">
    <i data-lucide="chevron-right"></i>
  </span>
  <% }  %>
  <%})%>
  <%}%>

</div>