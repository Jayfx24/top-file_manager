<!DOCTYPE html>
<html lang="en">
<%- include("./partials/head.ejs") %>

<body>
  <%- include("./partials/header.ejs") %>

  <main>

    <section class="container">
      <div class="open-menu"><button onclick="openNav()">Tree</button></div>
      <div class="content flex gap">
        <%- include("./partials/sideMenu.ejs") %>

        <div class="main-content">
          <!-- <p>This should show the the content of the projects | all</p> -->
          <% if (locals.breadcrumbs) {%>

          <%- include("./partials/breadcrumb.ejs") %>
          <%}%>

          
          <% if (locals.folders.length > 1){%>
          <table class="table ">
            <thead class="table_header">
              <tr class="th__row">
                <th class="th__item">File Name</th>
                <th class="th__item">size</th>
                <th class="th__item">created</th>
                <% if(locals.currentUser || !locals.shareUrl){%>
                <th class="th__item">last opened</th>
                <th class="th__item">actions</th>
                <%}%>
              </tr>
            </thead>


            <% locals.folders.forEach((folder)=> { %>
                <% if (folder.parentId===parentId){%>
            <tbody>
              <tr class="tr__row">
                <td class="tr__item">
                  <% if (locals.shareUrl){%>
                  <a href="/share/folder/<%=shareUrl %>/<%=folder?.id%>">
                    <%= folder.name %>
                  </a>
                  <% }else{%>
                  <a href="/folders/<%=folder?.id%>" class="row gap-1 ">
                    <div class="icon"><i class="" data-lucide="folder"></i></div>

                    <%= folder.name %>
                  </a>
                  <% }%>
                </td>
                <td class="tr__item">
                  <%= folder?.size || '' %>
                </td>

                <td class="tr__item">
                  <%= folder.createdAt.toLocaleDateString("en-US",{
                    month: "short",
                    day: "numeric",
                    year: "numeric",
                    hour: "2-digit", 
                    minute: "2-digit", 
                    hour12: true,
                  }) %>
                </td>

                <% if(locals.currentUser === folder.authorId){%>
                <td class="tr__item">
                  <%= folder.lastSeen %>
                </td>
                <td class="tr__item ">
                  <div class="action__btns flex gap-2">
                    <button class="dialog--update  strip icon icon--update" command="show-modal" commandfor="dialog--update" data-id="<%=folder.id%>" data-type="folder" data-name="<%=folder.name%>" data-parent="<%= folder.parentId %>">
                      <i data-lucide="save-plus" class=""></i>

                    </button>
                    <form action="/folders/<%=folder.id%>/delete" method="post">
                      <button class="delete strip icon--delete icon">
                        <i data-lucide="trash" class=""></i>

                      </button>
                    </form>
                    <button class="dialog--share strip icon icon--share" command="show-modal" commandfor="dialog--share" data-id="<%=folder.id%>" data-type="folder" data-name="<%=folder.name%>" data-func="share" data-parent="<%= folder.parentId %>">
                      <i data-lucide="share-2" class=""></i>

                    </button>
                  </div>
                </td>
                <%}%>
              </tr>

              <% }%>

                <% })%>
                <% if (locals.userFiles){%>
                <% locals?.userFiles.forEach((file)=> { %>
                <% if (file.folderId===parentId){%>
              <tr class="tr__row">
                <td class="tr__item">
                  <% if (locals.shareUrl){%>
                  <a href="/share/file/<%=shareUrl%>/<%=file.folderId%>/<%=file.id%>" class="row gap-1 ">
                    <div class="icon"><i class="" data-lucide="file"></i></div>
                    <%= file.name %>

                  </a>
                  <% }else{%>
                  <a href="/files/<%=file?.id%>" class="row gap-1 ">
                    <div class="icon"><i class="" data-lucide="file"></i></div>

                    <%= file.name %>
                  </a>
                  </a>
                  <% }%>

                </td>

                <td class="tr__item">
                  <%= formatBytes(file?.size) || '0' %>
                </td>

                <td class="tr__item">
                  <%= file.createdAt.toLocaleDateString("en-US",{
                  month: "short",
                    day: "numeric",
                    year: "numeric",
                    hour: "2-digit", 
                    minute: "2-digit", 
                    hour12: true,
                  }) %>


                  %>
                </td>

                <% if(locals.currentUser === file.authorId){%>
                <td class="tr__item">
                  <%= file.lastSeen %>
                </td>
                <td class="tr__item ">
                  <div class="action__btns row gap-2">
                    <form action="/files/<%=file.id%>/delete" method="post">
                      <button class="delete strip icon icon--delete">
                        <i data-lucide="trash" class=""></i>
                      </button>
                    </form>

                    <button class="dialog--update strip icon icon--update" command="show-modal" commandfor="dialog--update" data-id="<%=file.id%>" data-type="file" data-name="<%=file.name%>" data-parent="<%= file.folderId %>">
                      <i data-lucide="save-plus" class=""></i>


                    </button>
                  </div>
                </td>
                <%}%>
              </tr>

              <% }%>

                <% })%>

                <%}%>

                                                </tbody>
                                    </table>
                                    <%}%>

        </div>
      </div>

    </section>

  </main>

  <%- include("./partials/footer.ejs") %>
  <script>
    const openNav = () => {

      const sideMenu = document.getElementById("sideMenu")
      const openMenu = document.querySelector(".open-menu")
      sideMenu.classList.add("show")
      openMenu.classList.add("hide")

    };
    const closeNav = () => {

      const sideMenu = document.getElementById("sideMenu")
      const openMenu = document.querySelector(".open-menu")

      sideMenu.classList.remove("show")
      openMenu.classList.remove("hide")


    }
  </script>
</body>

</html>