<aside class="side-menu ">
  <div class="aside-content ">
    <div class="actions row gap-2">
      <button command="show-modal" commandfor="folder-dialog" class="btn--folder row gap-1">
        <i class="icons" data-lucide="folder"></i>
        New Folder</button>
      <button command="show-modal" commandfor="file-dialog" class=" btn--file row gap-1">
        <i class="icons" data-lucide="file"></i>

        New file
      </button>
      <div class="action__errors">
        <%- include("../partials/errors.ejs") %>

      </div>
    </div>
    <!-- <h2>
      Projects
    </h2> -->
    <div class="collapsible-list">

      <% function walk(folder, data, fileGroup) {
  
        if (!data) return '' ;
        const children=data[String(folder.id)] ?? [];
              const files=fileGroup[String(folder.id)] ?? [];
              const items=children.concat(files);
              if (items.length <=0)            return "" ;
               let html=`<ul class="sub__list folder__list hide">`;
  
              items.forEach((ele) => {
              if (!ele.mimetype) {
              html += `
              <li class="folder__item" data-type="folder">
                  <div class="row btw gap-2">
                    <a href="/folders/${ele.id}">
                        ${ele.name}
                    </a>
                    <span>
                                  <i data-lucide="chevron-down" class="dropdown"></i>
                                </span>
                  </div>
                  ${walk(ele, data, fileGroup)}
              </li>`;
              } else {
              html += `
              <li class="folder__item">
                  <a href="/files/${ele.id}">
                      ${ele.name}
                  </a>
  
              </li>`;
              }
              });
              html += `</ul>`;
              return html;
              }
  
  
              %>
      <ul class="main-list folder__list ">
        <% locals?.anchorFolders.forEach((anchor)=> { %>
        <li class="folder__item" data-type="folder">


          <div class="row btw gap-2">
            <a href="/folders/<%=anchor?.id%>">
              <%= anchor.name %>
            </a>
            <span>
              <i data-lucide="chevron-down" class="dropdown"></i>

            </span>
          </div>



          <%- walk(anchor,folderGroup,fileGroup) %>

        </li>
        <% })%>
      </ul>
    </div>





  </div>

</aside>


<%- include("../dialogs/folder.ejs") %>
<%- include("../dialogs/file.ejs") %>