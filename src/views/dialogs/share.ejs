<dialog id="dialog--share" closedby="any">

  <div class="dialog-container">
    <div class="dialog__info">
      <h1 class="dialog__title">Share a Folder</h1>
      <p class="dialog-description">Give others access to your files and collaborate with ease.</p>
    </div>
    <form action="/share" method="post">
      <input type="hidden" name="shareId" id="shareId">

      <div class="form-group">
        <label for="endDateDelta">
          Choose duration
        </label>
        <select name="endDateDelta" id="endDateDelta">
          <option value="">---Please choose duration</option>
          <option value="3">3 days </option>
          <option value="7"> 7 days </option>
          <option value="10"> 10 days </option>
        </select>
      </div>
      <button type="submit" class="form-btn">Activate</button>
    </form>
    <div class="dialog__actions">
      <button type="button" data-dialog-close="dialog--share" class="dialog-close strip icon--warning">
        <i class="icons" data-lucide="x">
        </i>
      </button>
    </div>
</dialog>