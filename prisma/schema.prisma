
generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}


model User {
  id Int    @id @default(autoincrement())
  firstName String
  lastName String
  username String   @unique
  pwd String
  folders Folder[]
  shared Shared[]
  createdAt DateTime @default(now())

  @@map("users")
}


model Folder {
  id Int    @id @default(autoincrement())
  name String  
  createdAt DateTime @default(now())
  updatedAt DateTime? 
  author User   @relation(fields: [authorId], references: [id])
  authorId Int
  files File[]
  lastSeen DateTime




  @@unique([name,authorId])
  @@map("folders")

}



model File {
  id Int    @id @default(autoincrement())
  name String  
  size Int
  url String  
  createdAt DateTime @default(now())
  updatedAt DateTime 
  folder Folder   @relation(fields: [folderId], references: [id])
  folderId Int
  lastSeen DateTime


  @@unique([name,folderId])
  @@map("files")

}


model Shared {
  id Int    @id @default(autoincrement())
  authorId Int
  name String  
  size Int
  generatedUrl String  
  createdAt DateTime @default(now())
  isActive Boolean
  endDate DateTime
  type String
  lastSeen DateTime
  viewsCount Int  @default(0)
  author User   @relation(fields: [authorId], references: [id])

  @@map("shared")
}