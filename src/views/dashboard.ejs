<!DOCTYPE html>
<html lang="en">
<%- include("./partials/head.ejs") %>

    <body>
        <%- include("./partials/header.ejs") %>

            <main>
                <section class="container">
                    <div class="content flex gap">
                        <%- include("./partials/sideMenu.ejs") %>

                            <div class="main-content">
                                <p>This should show the the content of the projects | all</p>

                                <!-- <% if (locals.noContent){%>
                                    <h2>
                                        <%=noContent%>
                                    </h2>
                                    <%}%> -->

                                        <% if (locals.folders){%>
                                            <ul class="folder__list">
                                                <% locals.folders.forEach((folder)=> { %>
                                                    <% if (folder.parentId===parentId){%>

                                                        <li class="folder__item">
                                                            <a href="/folders/<%=folder?.id%>">
                                                                <%= folder.name %>
                                                            </a>
                                                        </li>
                                                        <% }%>


                                                            <% })%>
                                                                <% if (locals.userFiles){%>

                                                                    <% locals?.userFiles.forEach((file)=> { %>
                                                                        <li class="folder__item">
                                                                            <a href="/files/<%=file?.id%>">
                                                                                <%= file.name %>
                                                                            </a>
                                                                        </li>
                                                                        <% })%>

                                                                            <%}%>
                                            </ul>
                                            <%}%>

                            </div>
                    </div>

                </section>

            </main>

            <%- include("./partials/footer.ejs") %>
    </body>

</html>